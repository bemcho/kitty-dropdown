#!/usr/bin/env python3
import json
from pathlib import Path
from shutil import copyfile

from gi.repository import Gio, GLib


source = Path(__file__).resolve().with_name("gnome-monitor")
uuid = json.loads((source / "metadata.json").read_text())["uuid"]
destination = Path(GLib.get_user_data_dir()) / "gnome-shell/extensions" / uuid
destination.mkdir(parents=True, exist_ok=True)
for name in ("metadata.json", "extension.js"):
    copyfile(source / name, destination / name)

settings = Gio.Settings.new("org.gnome.shell")
enabled = settings.get_strv("enabled-extensions")
disabled = settings.get_strv("disabled-extensions")
if uuid not in enabled:
    settings.set_strv("enabled-extensions", [*enabled, uuid])
if uuid in disabled:
    settings.set_strv("disabled-extensions", [name for name in disabled if name != uuid])
Gio.Settings.sync()

print(f"Installed {uuid} in {destination}.")
print("Log out and back in to load the GNOME Wayland monitor helper.")
